#!/bin/bash

# A simple script to display wifi name
# 'ssid -i' = with icon, 'ssid' = text only
# Cheers!
# Addy

SSID_NAME=$(iw dev 2>/dev/null | sed -n 's/^[[:space:]]*ssid[[:space:]]\+//p' | head -n 1)

if [[ -z "${SSID_NAME}" ]]; then
    SSID_NAME=$(nmcli -t -f TYPE,NAME connection show --active 2>/dev/null | awk -F: '$1 == "802-11-wireless" { sub(/^[^:]*:/, ""); print; exit }')
fi

if [[ -z "${SSID_NAME}" ]] && command -v iwgetid >/dev/null 2>&1; then
    SSID_NAME=$(iwgetid -r 2>/dev/null || /sbin/iwgetid -r 2>/dev/null)
fi

if [[ -n "${SSID_NAME}" ]]; then
	if  [[ $1 = "-i" ]]; then
    echo "  ${SSID_NAME}"
	else
    echo "${SSID_NAME}"
	fi
else
echo "Not Connected"
fi

exit 0
